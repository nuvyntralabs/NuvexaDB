{
  "name": "nuvexadb",
  "displayName": "NuvexaDB",
  "description": "Browse .nvx databases: Open / Close, collection tree, Browse Data, and Execute Query.",
  "version": "1.0.7",
  "publisher": "nuventra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuvyntralabs/NuvexaDB"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onView:nuvexadb.browser",
    "onCustomEditor:nuvexadb.explorer",
    "onCommand:nuvexa.open",
    "onCommand:nuvexa.close",
    "onCommand:nuvexa.about"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "nuvexa.open", "title": "NuvexaDB: Open Database" },
      { "command": "nuvexa.close", "title": "NuvexaDB: Close Database" },
      { "command": "nuvexa.about", "title": "NuvexaDB: About" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nuvexadb",
          "title": "NuvexaDB",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "nuvexadb": [
        {
          "type": "webview",
          "id": "nuvexadb.browser",
          "name": "Database Browser",
          "visibility": "visible"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "nuvexadb.explorer",
        "displayName": "Nuvexa Data Studio",
        "selector": [{ "filenamePattern": "*.nvx" }]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "tsc -p . && node --test test/package.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
