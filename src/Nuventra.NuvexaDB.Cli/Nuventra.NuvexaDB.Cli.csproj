<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nuvexa</ToolCommandName>
    <PackageId>Nuventra.NuvexaDB.Cli</PackageId>
    <Title>nuvexa — NuvexaDB CLI</Title>
    <Description>Command-line explorer for .nvx files. Used by the VS Code / Cursor extension and scripts.</Description>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nuventra.NuvexaDB.Tools\Nuventra.NuvexaDB.Tools.csproj" />
  </ItemGroup>

</Project>
