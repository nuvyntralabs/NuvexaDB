<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nuventra.NuvexaDB.Explorer.VisualExplainWindow"
        Title="Visual explain"
        Width="520" Height="320"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" MinWidth="88" Click="OnClose" Margin="0,12,0,0" />
    <Border Classes="card" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock x:Name="TitleBlock" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="BodyBlock" FontFamily="Menlo, Consolas, monospace" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
