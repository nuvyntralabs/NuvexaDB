<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nuventra.NuvexaDB.Explorer.IndexWindow"
        Title="Create index"
        Width="460" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Classes="card" Margin="16">
    <StackPanel Spacing="12">
      <TextBlock FontWeight="SemiBold" FontSize="15" Text="Secondary index" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Index a column so equality and range filters can avoid a full scan." />
      <TextBox x:Name="FieldBox" Watermark="Column or path, e.g. email or address.line1" />
      <TextBox x:Name="NameBox" Watermark="Index name (optional)" />
      <CheckBox x:Name="UniqueBox" Content="Unique" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" MinWidth="88" Click="OnCancel" />
        <Button Classes="accent" Content="Create index" MinWidth="108" Click="OnOk" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
