<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Nuventra.NuvexaDB.VisualStudio</RootNamespace>
    <Description>Visual Studio tool-window services for .nvx files. On Windows, VSSDK sources under Vsix/ compile into a package host.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.EndsWith('-windows'))">
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);VSSDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Vsix\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.EndsWith('-windows'))">
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.11.40262" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="NuvexaDB.pkgdef" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nuventra.NuvexaDB.Tools\Nuventra.NuvexaDB.Tools.csproj" />
  </ItemGroup>

</Project>
