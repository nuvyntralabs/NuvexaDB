<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="Nuventra.NuvexaDB.VisualStudio" Version="1.0.1" Language="en-US" Publisher="Nuventra" />
    <DisplayName>NuvexaDB Explorer</DisplayName>
    <Description>Open .nvx files in Visual Studio. Encrypted databases prompt for a key.</Description>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)" />
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="NuvexaDB.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.Assembly" Path="Nuventra.NuvexaDB.VisualStudio.dll" />
  </Assets>
</PackageManifest>
