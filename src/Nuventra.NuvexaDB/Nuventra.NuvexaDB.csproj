<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Nuventra.NuvexaDB</RootNamespace>
    <AssemblyName>Nuventra.NuvexaDB</AssemblyName>
    <PackageId>Nuventra.NuvexaDB</PackageId>
    <Title>NuvexaDB — embedded Mongo-like NoSQL for .NET and MAUI</Title>
    <Description>Embedded document database for .NET and .NET MAUI. Single encrypted .nvx file, Mongo-inspired queries, AES-256-GCM at rest. Runs in-process on Windows, macOS, Linux, Android, and iOS.</Description>
    <PackageTags>nuvexadb;nosql;embedded;mongodb;maui;dotnet;document-database;aes-gcm;nvx</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);IL2026;IL3050;CA2014</NoWarn>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nuventra.NuvexaDB.Tests" />
    <InternalsVisibleTo Include="Nuventra.NuvexaDB.Benchmarks" />
    <InternalsVisibleTo Include="Nuventra.NuvexaDB.Tools" />
  </ItemGroup>

</Project>
